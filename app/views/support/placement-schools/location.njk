{% extends "layouts/support.njk" %}

{% set primaryNavId = "placementSchools" %}
{% set secondaryNavId = "location" %}

{% set title = placementSchool.name %}
{% set caption = "Placement school" %}

{% block head %}
  {{ super() }}
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
{% endblock %}

{% block beforeContent %}
{{ govukBackLink({
  text: "Back",
  href: actions.back
}) }}
{% endblock %}

{% block content %}

{% include "_includes/notification-banner.njk" %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    {% include "./_page-heading.njk" %}

  </div>
</div>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">
    {% include "./_secondary-navigation.njk" %}
  </div>
</div>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    <h2 class="govuk-heading-m">Location</h2>

    {% if osMapsApiKey and placementSchool.schoolAddress.latitude and placementSchool.schoolAddress.longitude %}
      <div class="app-results-map" id="results-map" data-os-api-key="{{ osMapsApiKey }}"></div>
      <script type="application/json" id="os-map-points">{{
        [{
          lat: placementSchool.schoolAddress.latitude,
          lon: placementSchool.schoolAddress.longitude,
          name: placementSchool.name,
          status: placementSchool.schoolStatus.name
        }] | dump | safe
      }}</script>
      {% include "_includes/map-key.njk" %}
    {% else %}
      <p class="govuk-body">Location information is not available for this school.</p>
    {% endif %}

    {% set addressHtml %}
      {% if placementSchool.schoolAddress.line1.length %}
        {{ placementSchool.schoolAddress.line1 }}<br aria-hidden="true">
      {% endif %}
      {% if placementSchool.schoolAddress.line2.length %}
        {{ placementSchool.schoolAddress.line2 }}<br aria-hidden="true">
      {% endif %}
      {% if placementSchool.schoolAddress.line3.length %}
        {{ placementSchool.schoolAddress.line3 }}<br aria-hidden="true">
      {% endif %}
      {% if placementSchool.schoolAddress.town.length %}
        {{ placementSchool.schoolAddress.town }}<br aria-hidden="true">
      {% endif %}
      {% if placementSchool.schoolAddress.county.length %}
        {{ placementSchool.schoolAddress.county }}<br aria-hidden="true">
      {% endif %}
      {% if placementSchool.schoolAddress.postcode.length %}
        {{ placementSchool.schoolAddress.postcode }}
      {% endif %}
    {% endset %}

    {% set regionName = placementSchool.schoolDetail.region.name if placementSchool.schoolDetail and placementSchool.schoolDetail.region else '' %}

    {{ govukSummaryList({
      rows: [
        {
          key: {
            text: "Region"
          },
          value: {
            text: regionName if regionName.length else "Not known",
            classes: "govuk-hint" if not regionName.length
          }
        },
        {
          key: {
            text: "Address"
          },
          value: {
            html: addressHtml if addressHtml.length else "Not known",
            classes: "govuk-hint" if not addressHtml.length
          }
        }
      ]
    }) }}

  </div>
</div>

{% endblock %}

{% block pageScripts %}
  {% if osMapsApiKey and placementSchool.schoolAddress.latitude and placementSchool.schoolAddress.longitude %}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="/public/javascripts/os-results-map.js"></script>
  {% endif %}
{% endblock %}
