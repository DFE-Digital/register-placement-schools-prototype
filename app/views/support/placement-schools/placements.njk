{% extends "layouts/support.njk" %}

{% set primaryNavId = "placementSchools" %}
{% set secondaryNavId = "placements" %}

{% set title = placementSchool.name %}
{% set caption = "Placement school" %}

{% block beforeContent %}
{{ govukBackLink({
  text: "Back",
  href: actions.back
}) }}
{% endblock %}

{% block content %}

{% include "_includes/notification-banner.njk" %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    {% include "./_page-heading.njk" %}

  </div>
</div>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">
    {% include "./_secondary-navigation.njk" %}
  </div>
</div>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    <h2 class="govuk-heading-m">Placements</h2>

    {% if partnerships.length %}
      <table class="govuk-table">
        <thead class="govuk-table__head">
          <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">Academic year</th>
            <th scope="col" class="govuk-table__header">Provider name</th>
            <th scope="col" class="govuk-table__header">Subject</th>
          </tr>
        </thead>
        <tbody class="govuk-table__body">
          {% for partnership in partnerships %}
            <tr class="govuk-table__row">
              <td class="govuk-table__cell">
                {{ partnership.academicYear.name if partnership.academicYear and partnership.academicYear.name else "Not known" }}
              </td>
              <td class="govuk-table__cell">
                {{ partnership.provider.operatingName if partnership.provider and partnership.provider.operatingName else "Not known" }}
              </td>
              <td class="govuk-table__cell">
                {{ partnership.subject.name if partnership.subject and partnership.subject.name else "Not known" }}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>

    {% else %}
      <p class="govuk-body">There are no partnerships for {{ placementSchool.name if placementSchool.name else "this school" }}.</p>
    {% endif %}

  </div>
</div>

{% endblock %}
