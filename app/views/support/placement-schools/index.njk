{% extends "layouts/support.njk" %}

{% set primaryNavId = "placementSchools" %}

{% set title = "Placement schools (" + pagination.totalCount | numeral("0,0") + ")" %}

{% block content %}

{% include "_includes/notification-banner.njk" %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    {% include "_includes/page-heading.njk" %}

    {# {{ govukButton({
      text: "Add placement school",
      href: actions.new
    }) }} #}

  </div>
</div>

<div class="app-filter-layout">
  <div class="app-filter-layout__filter">
    {% include "./_filter-panel.njk" %}
  </div>

  <div class="app-filter-layout__content">

    <div class="app-action-bar">
      <div class="app-action-bar__filter"></div>
    </div>

    {% include "./_search-panel.njk" %}

    {% if placementSchools.length %}

      {% for school in placementSchools %}
        {% if school.status | lower == "open" %}
          {% set tagClass = "govuk-tag--green" %}
        {% elif school.status | lower == "closed" %}
          {% set tagClass = "govuk-tag--red" %}
        {% elif school.status | lower == "open, but proposed to close" %}
          {% set tagClass = "govuk-tag--orange" %}
        {% elif school.status | lower == "proposed to open" %}
          {% set tagClass = "govuk-tag--yellow" %}
        {% else %}
          {% set tagClass = "govuk-tag--grey" %}
        {% endif %}

        {% set nameHtml %}
          <a href="{{ actions.view }}/{{ school.id }}" class="govuk-link">
            {{ school.name }}
          </a>
          {{ govukTag({
            text: school.status if school.status.length else "Not known",
            classes: tagClass + " govuk-tag--no-max-width govuk-!-margin-left-1"
          }) }}
          {% if school.ukprn.length or school.urn.length %}
            <p class="govuk-hint govuk-!-margin-top-1 govuk-!-margin-bottom-0">
              {% if school.ukprn.length %}<b><abbr title="UK provider reference number">UKPRN</abbr>:</b> {{ school.ukprn }}{% endif %}
              {% if school.urn.length %}<b><abbr title="unique reference number">URN</abbr>:</b> {{ school.urn }}{% endif %}
            </p>
          {% endif %}
        {% endset %}

        {% set schoolTypeGroupHtml %}
          <ul class="govuk-list">
            <li>
              {{ school.group }}
            </li>
            <li class="govuk-!-font-size-16">
              {{ school.type }}
            </li>
          </ul>
        {% endset %}

        {% set educationPhaseHtml %}
          <ul class="govuk-list">
            <li>
              {{ school.educationPhase }}
            </li>
            {% if school.statutoryLowAge and school.statutoryHighAge %}
              <li class="govuk-!-font-size-16">
                Ages {{ school.statutoryLowAge }} to {{ school.statutoryHighAge }}
              </li>
            {% endif %}
          </ul>
        {% endset %}

        {% set addressHtml -%}
          {% if school.address.line1.length %}
            {{ school.address.line1 }}<br aria-hidden="true">
          {% endif %}
          {% if school.address.line2.length %}
            {{ school.address.line2 }}<br aria-hidden="true">
          {% endif %}
          {% if school.address.line3.length %}
            {{ school.address.line3 }}<br aria-hidden="true">
          {% endif %}
          {% if school.address.town.length %}
            {{ school.address.town }}<br aria-hidden="true">
          {% endif %}
          {% if school.address.county.length %}
            {{ school.address.county }}<br aria-hidden="true">
          {% endif %}
          {% if school.address.postcode.length %}
            {{ school.address.postcode }}
          {% endif %}
        {%- endset %}

        {% set academicYearsHtml %}
          <ul class="govuk-list govuk-list--spaced">
            {% for year in school.academicYears %}
              <li>
                {{ year.name }}
                <ul class="govuk-list govuk-list--bullet">
                  {% for provider in year.providers %}
                    <li>{{ provider.name }}</li>
                  {% endfor %}
                </ul>
              </li>
            {% endfor %}
          </ul>
        {% endset %}

        {{ govukSummaryList({
          card: {
            title: {
              html: nameHtml
            }
          },
          rows: [
            {
              key: {
                text: "Address"
              },
              value: {
                html: addressHtml if (school.address.line1.length and school.address.town.length and school.address.postcode.length) else "Not known",
                classes: "govuk-hint" if not (school.address.line1.length and school.address.town.length and school.address.postcode.length)
              }
            },
            {
              key: {
                text: "School type"
              },
              value: {
                html: schoolTypeGroupHtml
              }
            },
            {
              key: {
                text: "Education phase"
              },
              value: {
                html: educationPhaseHtml
              }
            },
            {
              key: {
                text: "Latest partnership"
              },
              value: {
                html: academicYearsHtml
              }
            }
          ]
        }) }}

      {% endfor %}

      {% include "_includes/pagination.njk" %}
    {% else %}
      <p class="govuk-body">There are no placement schools.</p>
    {% endif %}

  </div>
</div>

{% endblock %}
