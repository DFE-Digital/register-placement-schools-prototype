{% extends "layouts/main.njk" %}

{% set title = placementSchool.name %}

{% block beforeContent %}
  {% if backLink %}
    {{ govukBackLink({
      text: "Back to search results",
      href: backLink
    }) }}
  {% endif %}
{% endblock %}

{% block content %}

{% include "_includes/notification-banner.njk" %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    {% if placementSchool.status | lower == "open" %}
      {% set tagClass = "govuk-tag--green" %}
    {% elif placementSchool.status | lower == "closed" %}
      {% set tagClass = "govuk-tag--red" %}
    {% elif placementSchool.status | lower == "open, but proposed to close" %}
      {% set tagClass = "govuk-tag--orange" %}
    {% elif placementSchool.status | lower == "proposed to open" %}
      {% set tagClass = "govuk-tag--yellow" %}
    {% else %}
      {% set tagClass = "govuk-tag--grey" %}
    {% endif %}

    {% set headingTag %}
      {{ govukTag({
        text: placementSchool.status if placementSchool.status.length else "Not known",
        classes: tagClass + " govuk-tag__heading govuk-tag--no-max-width govuk-!-margin-left-1"
      }) }}
    {% endset %}

    {% set headingClass = "govuk-!-margin-bottom-2" %}

    {% include "_includes/page-heading.njk" %}

    {% if placementSchool.ukprn.length or placementSchool.urn.length %}
      <p class="govuk-hint">
        {% if placementSchool.ukprn.length %}<b><abbr title="UK provider reference number">UKPRN</abbr>:</b> {{ placementSchool.ukprn }}{% endif %}
        {% if placementSchool.urn.length %}<b><abbr title="unique reference number">URN</abbr>:</b> {{ placementSchool.urn }}{% endif %}
      </p>
    {% endif %}

    {% if showSearchAgain %}
      <p class="govuk-body govuk-!-margin-top-5">
        <a class="govuk-link" href="{{ actions.newSearch }}">Search again</a>
      </p>
    {% endif %}

    {% set urnHtml %}
      <ul class="govuk-list">
        <li>
          {{ placementSchool.urn }}
        </li>
        <li>
          <a href="https://get-information-schools.service.gov.uk/Establishments/Establishment/Details/{{placementSchool.urn}}" target="_blank" rel="noreferrer nofollow" class="govuk-link">View school on Get information about schools (opens in new tab)</a>
        </li>
      </ul>
    {% endset %}

    {% set schoolTypeGroupHtml %}
      <ul class="govuk-list">
        <li>
          {{ placementSchool.group }}
        </li>
        <li class="govuk-!-font-size-16">
          {{ placementSchool.type }}
        </li>
      </ul>
    {% endset %}

    {% set educationPhaseHtml %}
      <ul class="govuk-list">
        <li>
          {{ placementSchool.educationPhase }}
        </li>
        {% if placementSchool.detail.statutoryLowAge and placementSchool.detail.statutoryHighAge %}
          <li class="govuk-!-font-size-16">
            Ages {{ placementSchool.detail.statutoryLowAge }} to {{ placementSchool.detail.statutoryHighAge }}
          </li>
        {% endif %}
      </ul>
    {% endset %}

    {% set addressHtml -%}
      {% if placementSchool.address.line1.length %}
        {{ placementSchool.address.line1 }}<br aria-hidden="true">
      {% endif %}
      {% if placementSchool.address.line2.length %}
        {{ placementSchool.address.line2 }}<br aria-hidden="true">
      {% endif %}
      {% if placementSchool.address.line3.length %}
        {{ placementSchool.address.line3 }}<br aria-hidden="true">
      {% endif %}
      {% if placementSchool.address.town.length %}
        {{ placementSchool.address.town }}<br aria-hidden="true">
      {% endif %}
      {% if placementSchool.address.county.length %}
        {{ placementSchool.address.county }}<br aria-hidden="true">
      {% endif %}
      {% if placementSchool.address.postcode.length %}
        {{ placementSchool.address.postcode }}
      {% endif %}
      {% if placementSchool.address.latitude and placementSchool.address.longitude %}
        <p class="govuk-body govuk-!-margin-top-3">
          <a href="https://www.openstreetmap.org/?mlat={{ placementSchool.address.latitude }}&mlon={{ placementSchool.address.longitude }}&zoom=17"
            target="_blank"
            rel="noreferrer"
            class="govuk-link">
            View school on map (opens in new tab)
          </a>
        </p>
      {% endif %}
    {%- endset %}

    {% set academicYearsHtml %}
      {% if placementSchool.academicYears.length %}
        <ul class="govuk-list govuk-list--spaced">
          {% for year in placementSchool.academicYears %}
            <li>
              <strong>{{ year.name }}</strong>
              <ul class="govuk-list govuk-list--bullet">
                {% for provider in year.providers %}
                  <li>{{ provider.name }}</li>
                {% endfor %}
              </ul>
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p class="govuk-body">The school has not hosted any trainees</p>
      {% endif %}
    {% endset %}

    {{ govukSummaryList({
      rows: [
        {
          key: {
            text: "School status"
          },
          value: {
            text: placementSchool.status if placementSchool.status.length else "Not known",
            classes: "govuk-hint" if not placementSchool.status.length
          }
        } if 1==0,
        {
          key: {
            text: "Address"
          },
          value: {
            html: addressHtml if (placementSchool.address.line1.length and placementSchool.address.town.length and placementSchool.address.postcode.length) else "Not known",
            classes: "govuk-hint" if not (placementSchool.address.line1.length and placementSchool.address.town.length and placementSchool.address.postcode.length)
          }
        },
        {
          key: {
            text: "UK provider reference number (UKPRN)"
          },
          value: {
            text: placementSchool.ukprn if placementSchool.ukprn.length else "Not known",
            classes: "govuk-hint" if not placementSchool.ukprn.length
          }
        } if 1==0,
        {
          key: {
            text: "Unique reference number (URN)"
          },
          value: {
            html: urnHtml
          }
        } if 1==0,
        {
          key: {
            text: "School type"
          },
          value: {
            html: schoolTypeGroupHtml
          }
        },
        {
          key: {
            text: "Education phase"
          },
          value: {
            html: educationPhaseHtml
          }
        },
        {
          key: {
            text: "Placements"
          },
          value: {
            html: academicYearsHtml
          }
        }
      ]
    }) }}

    <p class="govuk-body">
      <a href="https://get-information-schools.service.gov.uk/Establishments/Establishment/Details/{{placementSchool.urn}}" target="_blank" rel="noreferrer nofollow" class="govuk-link">View school on Get information about schools (opens in new tab)</a>
    </p>

    {% if placementSchool.relatedSchoolGroups and placementSchool.relatedSchoolGroups.length %}
      <h2 class="govuk-heading-m">Related schools</h2>

      {% for group in placementSchool.relatedSchoolGroups %}
        <p class="govuk-body">{{ placementSchool.name }} {{ group.label }}:</p>
        <ul class="govuk-list govuk-list--bullet govuk-list--spaced govuk-!-margin-bottom-6">
          {% for relatedSchool in group.schools %}
            <li>
              <a class="govuk-link" href="/results?q=school&schoolId={{ relatedSchool.id }}{{ '&from=' + query.from if query.from }}">{{ relatedSchool.name }}</a>
            </li>
          {% endfor %}
        </ul>
      {% endfor %}
    {% endif %}

  </div>
</div>

{% endblock %}
