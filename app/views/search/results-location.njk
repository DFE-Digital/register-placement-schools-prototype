{% extends "layouts/main.njk" %}

{% if pagination.totalCount %}
  {% set title = pagination.totalCount | numeral("0,0") + " placement school" + ("s" if pagination.totalCount > 1) + " near ‘" + location.name + "’" %}
{% else %}
  {% set title = "No placement schools near ‘" + location.name + "’" %}
{% endif %}

{% block content %}

{% include "_includes/notification-banner.njk" %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    {% include "_includes/page-heading.njk" %}

    <p class="govuk-body">
      Showing placement schools within {{ selectedRadius }} miles of ‘{{ location.name }}’.
    </p>

    <div class="govuk-button-group">
      {{ govukButton({
        text: "Download results as CSV",
        href: actions.download
      }) }}

      <a class="govuk-link" href="{{ actions.newSearch }}">Search again</a>
    </div>

  </div>
</div>

<div class="app-filter-layout">
  <div class="app-filter-layout__filter">
    {% include "./_filter-panel.njk" %}
  </div>

  <div class="app-filter-layout__content">

    <div class="app-action-bar">
      <div class="app-action-bar__filter"></div>
    </div>

    {% include "./_search-panel.njk" %}

    {% if placements.length %}

      {% for placement in placements %}

        {% if placement.school.status | lower == "open" %}
          {% set tagClass = "govuk-tag--green" %}
        {% elif placement.school.status | lower == "closed" %}
          {% set tagClass = "govuk-tag--red" %}
        {% elif placement.school.status | lower == "open, but proposed to close" %}
          {% set tagClass = "govuk-tag--orange" %}
        {% elif placement.school.status | lower == "proposed to open" %}
          {% set tagClass = "govuk-tag--yellow" %}
        {% else %}
          {% set tagClass = "govuk-tag--grey" %}
        {% endif %}

        {% set nameHtml %}
          {# <a href="{{ actions.view }}/{{ placement.school.id }}" class="govuk-link"> #}
            {{ placement.school.name }}
          {# </a> #}
          {{ govukTag({
            text: placement.school.status if placement.school.status.length else "Not known",
            classes: tagClass + " govuk-tag--no-max-width govuk-!-margin-left-1"
          }) }}
          {% if placement.school.ukprn.length or placement.school.urn.length %}
            <p class="govuk-hint govuk-!-margin-top-1 govuk-!-margin-bottom-0">
              {% if placement.school.ukprn.length %}<b>UKPRN:</b> {{ placement.school.ukprn }}{% endif %}
              {% if placement.school.urn.length %}<b>URN:</b> {{ placement.school.urn }}{% endif %}
            </p>
          {% endif %}
        {% endset %}

        {% set urnHtml %}
          <ul class="govuk-list">
            <li>
              {{ placement.school.urn }}
            </li>
            <li>
              <a href="https://get-information-schools.service.gov.uk/Establishments/Establishment/Details/{{ placement.school.urn }}" target="_blank" rel="noreferrer nofollow" class="govuk-link">View school on Get information about schools (opens in new tab)</a>
            </li>
          </ul>
        {% endset %}

        {% set schoolTypeGroupHtml %}
          <ul class="govuk-list">
            <li>
              {{ placement.school.group }}
            </li>
            <li class="govuk-!-font-size-16">
              {{ placement.school.type }}
            </li>
          </ul>
        {% endset %}

        {% set educationPhaseHtml %}
          <ul class="govuk-list">
            <li>
              {{ placement.school.educationPhase }}
            </li>
            {% if placement.school.statutoryLowAge and placement.school.statutoryHighAge %}
              <li class="govuk-!-font-size-16">
                Ages {{ placement.school.statutoryLowAge }} to {{ placement.school.statutoryHighAge }}
              </li>
            {% endif %}
          </ul>
        {% endset %}

        {% set addressHtml -%}
          {% if placement.school.address.line1.length %}
            {{ placement.school.address.line1 }}<br>
          {% endif %}
          {% if placement.school.address.line2.length %}
            {{ placement.school.address.line2 }}<br>
          {% endif %}
          {% if placement.school.address.line3.length %}
            {{ placement.school.address.line3 }}<br>
          {% endif %}
          {% if placement.school.address.town.length %}
            {{ placement.school.address.town }}<br>
          {% endif %}
          {% if placement.school.address.county.length %}
            {{ placement.school.address.county }}<br>
          {% endif %}
          {% if placement.school.address.postcode.length %}
            {{ placement.school.address.postcode }}<br>
          {% endif %}
        {%- endset %}

        {% set academicYearsHtml %}
          {% if placement.academicYears.length %}
            <ul class="govuk-list govuk-list--bullet">
              {% for year in placement.academicYears %}
                <li>{{ year }}</li>
              {% endfor %}
            </ul>
          {% else %}
            <p class="govuk-body">The school has not hosted any trainees</p>
          {% endif %}
        {% endset %}

        {{ govukSummaryList({
          card: {
            title: {
              html: nameHtml
            }
          },
          rows: [
            {
              key: {
                text: "Distance"
              },
              value: {
                text: placement.distance | round(1) + " miles"
              }
            },
            {
              key: {
                text: "School status"
              },
              value: {
                text: placement.school.status if placement.school.status.length else "Not known",
                classes: "govuk-hint" if not placement.school.status.length
              }
            } if 1==0,
            {
              key: {
                text: "UK provider reference number (UKPRN)"
              },
              value: {
                text: placement.school.ukprn if placement.school.ukprn.length else "Not known",
                classes: "govuk-hint" if not placement.school.ukprn.length
              }
            } if 1==0,
            {
              key: {
                text: "Unique reference number (URN)"
              },
              value: {
                html: urnHtml
              }
            } if 1==0,
            {
              key: {
                text: "School type"
              },
              value: {
                html: schoolTypeGroupHtml
              }
            },
            {
              key: {
                text: "Education phase"
              },
              value: {
                html: educationPhaseHtml
              }
            },
            {
              key: {
                text: "Address"
              },
              value: {
                html: addressHtml if (placement.school.address.line1.length and placement.school.address.town.length and placement.school.address.postcode.length) else "Not known",
                classes: "govuk-hint" if not (placement.school.address.line1.length and placement.school.address.town.length and placement.school.address.postcode.length)
              }
            },
            {
              key: {
                text: "Academic years"
              },
              value: {
                html: academicYearsHtml
              }
            }
          ]
        }) }}

      {% endfor %}
      {% include "_includes/pagination.njk" %}
    {% else %}
      <p class="govuk-body">There are no placement schools within {{ selectedRadius }} miles of ‘{{ location.name }}’ matching your criteria.</p>
    {% endif %}

  </div>
</div>

{% endblock %}
